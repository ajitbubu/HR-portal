DATABASE_URL=postgresql://hruser:hrpass@localhost:5432/datasafeguard_hr
SECRET_KEY=your-secret-key-change-in-production
CORS_ORIGINS=["http://localhost:3000"]
APP_BASE_URL=http://localhost:3000

# Email (Microsoft 365 / Outlook SMTP)
# Set MAIL_ENABLED=true and fill credentials to send real emails.
# Local dev: keep MAIL_ENABLED=false and use Mailpit (http://localhost:8025).
MAIL_ENABLED=false
MAIL_SERVER=smtp.office365.com
MAIL_PORT=587
MAIL_USERNAME=hr@datasafeguard.ai
MAIL_PASSWORD=your-microsoft-365-password-or-app-password
MAIL_FROM=hr@datasafeguard.ai
MAIL_FROM_NAME=DataSafeguard HR
MAIL_STARTTLS=true
MAIL_SSL_TLS=false

# ── Microsoft 365 SSO (Azure AD) ─────────────────────────────────────────────
# Obtain from portal.azure.com → Azure Active Directory → App registrations.
# Leave blank to disable the "Sign in with Microsoft" button on the login page.
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=
AZURE_REDIRECT_URI=http://localhost:8000/api/auth/microsoft/callback
