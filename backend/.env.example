DATABASE_URL=postgresql://hruser:hrpass@localhost:5432/datasafeguard_hr
SECRET_KEY=your-secret-key-change-in-production
CORS_ORIGINS=["http://localhost:3000"]
APP_BASE_URL=http://localhost:3000

# Email — set MAIL_ENABLED=true to capture/send emails
# Local dev: Mailpit is included in docker-compose.yml (web UI at http://localhost:8025)
MAIL_ENABLED=false
MAIL_SERVER=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=hr@datasafeguard.ai
MAIL_FROM_NAME=DataSafeguard HR
MAIL_STARTTLS=false
MAIL_SSL_TLS=false
