# Email (Microsoft 365 / Outlook SMTP)
# Set MAIL_ENABLED=true and fill credentials to send real emails.
# Local dev: keep MAIL_ENABLED=false and use Mailpit (http://localhost:8025).
MAIL_ENABLED=false
MAIL_SERVER=smtp.office365.com
MAIL_PORT=587
MAIL_USERNAME=hr@datasafeguard.ai
MAIL_PASSWORD=your-microsoft-365-password-or-app-password
MAIL_FROM=hr@datasafeguard.ai
MAIL_FROM_NAME=DataSafeguard HR
MAIL_STARTTLS=true
MAIL_SSL_TLS=false
